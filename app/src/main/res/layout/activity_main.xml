<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Data Tracker &amp; Speed Meter"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:elevation="4dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tvTodayUsage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today's Usage: 0.0 MB"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:id="@+id/tvMonthlyUsage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monthly Usage: 0.00 GB"
            android:textSize="16sp"
            android:textColor="#475569"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etDataLimit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter daily data alert limit in MB (e.g. 1500)"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnSaveLimit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Data Alert Limit" />

    <Button
        android:id="@+id/btnPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grant Usage Permission"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnStartService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Status Bar Speed Meter"
        android:layout_marginTop="8dp" />

</LinearLayout>
